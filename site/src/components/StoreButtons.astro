---
import { STORE_URLS } from "../config";

interface Props {
  appStoreBadge?: boolean;
  light?: boolean;
  center?: boolean;
}
const { appStoreBadge = false, light = false, center = false } = Astro.props;
const showBadge = appStoreBadge && Boolean(STORE_URLS.ios);

const stores = [
  {
    device: "iPhone",
    name: "App Store",
    url: STORE_URLS.ios,
    badge: showBadge ? "/app-store-badge-ja.svg" : undefined,
  },
  { device: "Android", name: "Google Play", url: STORE_URLS.android },
];
---
<div class:list={["stores", { "stores--center": center, "stores--badged": showBadge }]}>
  {stores.map((s) =>
    s.url ? (
      <a class:list={[s.badge ? "store-badge" : "store", { "store--light": light && !s.badge }]} href={s.url} rel="noopener">
        {s.badge ? (
          <img src={s.badge} width="109" height="40" alt="App Storeからダウンロード" />
        ) : (
          <>
            <span class="store__sub">{s.device}</span>
            <span class="store__main">{s.name}</span>
          </>
        )}
      </a>
    ) : (
      <span class:list={["store", "store--soon", { "store--light": light }]}>
        <span class="store__sub">{s.device} ・ 近日公開</span>
        <span class="store__main">{s.name}</span>
      </span>
    ),
  )}
</div>
