---
import { STORE_URLS } from "../config";

interface Props {
  badges?: boolean;
  light?: boolean;
  center?: boolean;
}
const { badges = false, light = false, center = false } = Astro.props;

const stores = [
  {
    device: "iPhone",
    name: "App Store",
    url: STORE_URLS.ios,
    badge: {
      src: "/app-store-badge-ja.svg", width: 109, height: 40,
      alt: "App Storeからダウンロード",
    },
  },
  {
    device: "Android",
    name: "Google Play",
    url: STORE_URLS.android,
    badge: {
      src: "/google-play-badge-ja.png", width: 646, height: 250,
      alt: "Google Playで手に入れよう", class: "store-badge__play",
    },
  },
];
---
<div class:list={["stores", { "stores--center": center, "stores--badged": badges }]}>
  {stores.map((s) =>
    s.url ? (
      <a class:list={[badges ? "store-badge" : "store", { "store--light": light && !badges }]} href={s.url} rel="noopener">
        {badges ? (
          <img {...s.badge} />
        ) : (
          <>
            <span class="store__sub">{s.device}</span>
            <span class="store__main">{s.name}</span>
          </>
        )}
      </a>
    ) : (
      <span class:list={["store", "store--soon", { "store--light": light }]}>
        <span class="store__sub">{s.device} ・ 近日公開</span>
        <span class="store__main">{s.name}</span>
      </span>
    ),
  )}
</div>
