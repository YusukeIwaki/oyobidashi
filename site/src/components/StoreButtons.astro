---
import { STORE_URLS } from "../config";

interface Props {
  light?: boolean;
  center?: boolean;
}
const { light = false, center = false } = Astro.props;

const stores = [
  { device: "iPhone", name: "App Store", url: STORE_URLS.ios },
  { device: "Android", name: "Google Play", url: STORE_URLS.android },
];
---
<div class:list={["stores", { "stores--center": center }]}>
  {stores.map((s) =>
    s.url ? (
      <a class:list={["store", { "store--light": light }]} href={s.url} rel="noopener">
        <span class="store__sub">{s.device}</span>
        <span class="store__main">{s.name}</span>
      </a>
    ) : (
      <span class:list={["store", "store--soon", { "store--light": light }]}>
        <span class="store__sub">{s.device} ・ 近日公開</span>
        <span class="store__main">{s.name}</span>
      </span>
    ),
  )}
</div>
