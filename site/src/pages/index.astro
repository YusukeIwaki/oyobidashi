---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Ask from "../components/Ask.astro";
import Scene from "../components/Scene.astro";
import Delivery from "../components/Delivery.astro";
import Setup from "../components/Setup.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Oyobidashi — AIが電話でお呼び出し"
  ogTitle="Oyobidashi — AIが電話でお呼び出し"
  description="「何かあったら電話して」と頼んで、席を立てます。AIエージェントが判断に迷うと、あなたのスマホが鳴ります。声で答えれば作業は進みます。MCPで使える、AIからの電話。無料、iOS / Android対応。"
>
  <Header />
  <main id="main">
    <Hero />
    <Ask />
    <Scene />
    <Delivery />
    <Setup />
    <Pricing />
    <Faq />
    <Download />
  </main>
  <Footer />
</Base>
