---
import Base from "../layouts/Base.astro";
import policy from "../content/privacy-policy.json";

const deletionSubject = encodeURIComponent("Oyobidashi アカウント削除");
const deletionMail = `mailto:q7w8e9w8q7w8e9@yahoo.co.jp?subject=${deletionSubject}`;
---
<Base title="プライバシーポリシー | お呼び出し" description="お呼び出しのアプリとクラウドサービスにおけるデータの取り扱い、第三者AIへの送信、アカウント削除について。">
  <main id="main" class="wrap policy">
    <a href="/">お呼び出し トップへ</a>
    <h1>プライバシーポリシー</h1>
    {policy.map(({ title, paragraphs, link }) => (
      <section>
        <h2>{title}</h2>
        {paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {link && <p><a href={link}>問い合わせ窓口を開く</a></p>}
      </section>
    ))}
    <section id="account-deletion">
      <h2>アカウント削除の申請</h2>
      <p>Oyobidashiのクラウドアカウントの削除は、下のメール窓口から申請できます。使用しているログイン方法をお知らせください。本人確認の手順を返信します。</p>
      <p>本人確認後、クラウドアカウント、質問と回答の履歴、登録端末、MCPの連携情報を削除します。購入の照合や不正利用の防止に必要な情報の保持については、「保存と削除」をご覧ください。定期購入は購入したストアで解約できます。</p>
      <p><a href={deletionMail}>メールで削除を申請する</a></p>
    </section>
  </main>
</Base>

<style>
  .policy { max-width: 50rem; padding-block: clamp(2rem, 6vw, 4.5rem); }
  h1 { margin-block: 1.3rem 2.4rem; font-size: clamp(1.55rem, 4vw, 2.5rem); }
  h2 { font-size: 1.15rem; margin-block: 2rem .65rem; }
  p { line-height: 1.85; margin-block: .7rem; }
  a { text-decoration: underline; text-underline-offset: .22em; }
</style>
